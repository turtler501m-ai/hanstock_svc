[Unit]
Description=Hanstock Domestic Namuh Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/hanstock_svc
ExecStartPre=/usr/bin/mkdir -p /home/ubuntu/hanstock_svc/logs
ExecStart=/home/ubuntu/hanstock_svc/.venv/bin/uvicorn src.dashboard:app --host 127.0.0.1 --port 8011 --log-level error
StandardOutput=null
StandardError=null
Restart=always
RestartSec=5
Environment=PATH=/home/ubuntu/hanstock_svc/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/home/ubuntu/hanstock_svc/.env
Environment=HANSTOCK_FILE_ONLY_LOGGING=1

[Install]
WantedBy=multi-user.target
